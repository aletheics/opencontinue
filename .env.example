# Provider selection: openai-compatible | ollama | echo
OPENCONTINUE_PROVIDER=openai-compatible

# OpenAI-compatible endpoint (include /v1):
#   OpenAI:        https://api.openai.com/v1
#   DeepSeek:      https://api.deepseek.com/v1
#   Ollama:        http://127.0.0.1:11434/v1
#   vLLM/LM Studio: your local endpoint
OPENCONTINUE_BASE_URL=https://api.openai.com/v1
OPENCONTINUE_API_KEY=
OPENCONTINUE_MODEL=gpt-4o-mini

# Optional
# OPENCONTINUE_PROVIDER=ollama
# OPENCONTINUE_BASE_URL=http://127.0.0.1:11434/v1
# OPENCONTINUE_MODEL=qwen2.5-coder:7b
# OPENCONTINUE_SYSTEM_PROMPT=You are a concise coding assistant.
# OPENCONTINUE_PORT=8787
