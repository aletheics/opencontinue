{
  "name": "opencontinue",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The open continuum for AI-assisted engineering.",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx apps/cli/src/index.ts",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "link": "cd apps/cli && npm link",
    "check": "tsx apps/cli/src/index.ts check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.1.0"
  }
}
